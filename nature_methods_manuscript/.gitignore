# Publisher-provided material is kept locally with a tracked provenance record.
template/vendor/

# Draft prose and rendered submission artifacts are intentionally local until approved.
manuscript/drafts/
manuscript/rendered/

# Local full-text and SI retrievals are auditable working copies, not source
# material for the repository. Their checksums belong in the reading report.
literature/full_text_*/

# Local tool caches and editor artifacts.
.cache/
*.aux
*.bbl
*.blg
*.log
*.out
*.pdf
